{
  "manifest_version": 3,
  "name": "Overlayable",
  "version": "0.4.0",
  "description": "geojson.io 지도 위에 이미지를 오버레이로 띄우고, 지도 이동/확대/회전에 맞춰 함께 움직입니다. 투명도/확대축소/회전 조절과 웹·이미지 조작 모드 전환을 지원합니다.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "Overlayable — 클릭하여 패널 토글"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "storage", "unlimitedStorage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://geojson.io/*"],
      "js": [
        "src/transform.js",
        "src/geo.js",
        "src/overlay.js",
        "src/workspace.js",
        "src/corners.js",
        "src/workspace-panel.js",
        "src/panel.js",
        "src/storage.js",
        "src/api.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://geojson.io/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
