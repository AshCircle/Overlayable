{
  "manifest_version": 3,
  "name": "Overlayable",
  "version": "0.1.0",
  "description": "웹 페이지 위에 이미지를 오버레이로 띄우고 투명도/확대축소/회전을 조절하며, Ctrl 홀드로 웹 조작 모드와 이미지 조작 모드를 전환합니다.",
  "action": {
    "default_title": "Overlayable — 클릭하여 패널 토글"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/transform.js",
        "src/overlay.js",
        "src/panel.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
